---
import { getAlternates, getLocale } from "virtual:astro-localized-routes";
---

<!doctype html>
<html lang={getLocale(Astro)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Localized Routes</title>
  </head>
  <body>
    <nav>
      {getAlternates(Astro).map(({ locale, path }) => (
        <a href={path} hreflang={locale}>
          {locale}
        </a>
      ))}
    </nav>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
