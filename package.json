{
  "name": "astro-localized-routes",
  "version": "0.0.0",
  "description": "A better version of Astro's i18n routing.",
  "keywords": [
    "astro",
    "astro-integration",
    "i18n",
    "internationalization",
    "pages",
    "routing"
  ],
  "homepage": "https://github.com/genzzo/astro-localized-routes#readme",
  "bugs": {
    "url": "https://github.com/genzzo/astro-localized-routes/issues"
  },
  "license": "MIT",
  "author": "genzzo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genzzo/astro-localized-routes.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:playgrounds": "pnpm -r --filter './playgrounds/*' astro check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --deny-warnings --fix",
    "format:check": "oxfmt --check && prettier --check \"**/*.astro\"",
    "format": "oxfmt --write && prettier --write --log-level warn \"**/*.astro\"",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "astro": "^7.3.2",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "astro": "^6.0.3 || ^7.0.0"
  }
}
